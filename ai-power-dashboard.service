[Unit]
Description=AI Power and Token Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
Environment=PYTHONUNBUFFERED=1
Environment=AI_DASH_HOST=127.0.0.1
Environment=AI_DASH_PORT=8092
ExecStart=/usr/bin/python3 /opt/ai-power-dashboard/app.py serve
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
